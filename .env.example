# Environment Variables

## Backend (.env)

# Server port (Vercel will override this)
PORT=3000

# Node environment
NODE_ENV=production

# Allowed CORS origins (comma-separated)
# For Vercel deployment, add your frontend URL:
# ALLOWED_ORIGINS=http://localhost:4200,https://space-invaders-frontend.vercel.app,https://*.vercel.app
ALLOWED_ORIGINS=http://localhost:4200

# Add any other environment variables here
